09_database_architecture.md
Storage Technologies
Component	Purpose	Technology
Metadata	Assets, versions, users, trust records	PostgreSQL
Vectors	Embeddings, semantic search	Qdrant
Graph	Relationships, knowledge graph	Neo4j
Raw Files	Original documents, attachments	S3 / Object Storage
PostgreSQL Schema
Users Table
sql
CREATE TABLE users (
    id UUID PRIMARY KEY,
    email VARCHAR(255) UNIQUE NOT NULL,
    password VARCHAR(255),
    name VARCHAR(255) NOT NULL,
    title VARCHAR(255),
    department_id UUID,
    manager_id UUID,
    start_date DATE,
    end_date DATE,
    is_active BOOLEAN DEFAULT TRUE,
    expertise_areas JSONB DEFAULT '[]',
    trust_score FLOAT DEFAULT 0.5,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP
);
Teams Table
sql
CREATE TABLE teams (
    id UUID PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    department_id UUID,
    lead_id UUID,
    is_active BOOLEAN DEFAULT TRUE,
    purpose TEXT,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP
);
Departments Table
sql
CREATE TABLE departments (
    id UUID PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    parent_department_id UUID,
    head_id UUID,
    default_access_level VARCHAR(50) DEFAULT 'INTERNAL',
    created_at TIMESTAMP DEFAULT NOW()
);
Assets Table
sql
CREATE TABLE assets (
    id UUID PRIMARY KEY,
    source_id VARCHAR(255),
    connector_id UUID,
    title VARCHAR(500) NOT NULL,
    content TEXT NOT NULL,
    content_type VARCHAR(50) NOT NULL,
    checksum VARCHAR(64),
    created_at TIMESTAMP DEFAULT NOW(),
    created_by_id UUID,
    updated_at TIMESTAMP,
    updated_by_id UUID,
    source_url VARCHAR(500),
    access_level VARCHAR(50) DEFAULT 'INTERNAL',
    owner_id UUID,
    owner_type VARCHAR(50),
    status VARCHAR(50) DEFAULT 'ACTIVE',
    current_version_id UUID,
    metadata JSONB DEFAULT '{}'
);
Versions Table
sql
CREATE TABLE versions (
    id UUID PRIMARY KEY,
    asset_id UUID REFERENCES assets(id),
    version_number INTEGER NOT NULL,
    content TEXT NOT NULL,
    content_hash VARCHAR(64) NOT NULL,
    change_type VARCHAR(50),
    change_summary TEXT,
    created_at TIMESTAMP DEFAULT NOW(),
    created_by_id UUID,
    previous_version_id UUID
);
Chunks Table
sql
CREATE TABLE chunks (
    id UUID PRIMARY KEY,
    asset_id UUID REFERENCES assets(id),
    version_id UUID REFERENCES versions(id),
    content TEXT NOT NULL,
    token_count INTEGER NOT NULL,
    chunk_index INTEGER NOT NULL,
    heading_path VARCHAR(500),
    embedding_id VARCHAR(100),
    start_offset INTEGER,
    end_offset INTEGER,
    parent_chunk_id UUID
);
Trust Records Table
sql
CREATE TABLE trust_records (
    id UUID PRIMARY KEY,
    asset_id UUID REFERENCES assets(id),
    chunk_id UUID REFERENCES chunks(id),
    version_id UUID REFERENCES versions(id),
    trust_score FLOAT NOT NULL,
    freshness_score FLOAT NOT NULL,
    authority_score FLOAT NOT NULL,
    verification_score FLOAT NOT NULL,
    evaluation_method VARCHAR(50) NOT NULL,
    evaluated_at TIMESTAMP DEFAULT NOW(),
    evaluated_by_id UUID,
    reasoning TEXT,
    sources_verified TEXT,
    next_evaluation_due TIMESTAMP
);
Decay Events Table
sql
CREATE TABLE decay_events (
    id UUID PRIMARY KEY,
    asset_id UUID REFERENCES assets(id),
    version_id UUID REFERENCES versions(id),
    decay_type VARCHAR(50) NOT NULL,
    decay_rate FLOAT NOT NULL,
    decay_score FLOAT NOT NULL,
    detected_at TIMESTAMP DEFAULT NOW(),
    detected_by VARCHAR(50) NOT NULL,
    trigger_event VARCHAR(255),
    is_resolved BOOLEAN DEFAULT FALSE,
    resolved_at TIMESTAMP,
    resolution_action VARCHAR(50),
    resolved_by_id UUID
